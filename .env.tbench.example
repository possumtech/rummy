# terminal-bench 2.0 / Harbor configuration — SHARED BASE TEMPLATE.
# Copy to .env.tbench and edit local paths. Loaded by every
# `npm run test:tbench:<profile>` script before its profile overlay.
# API keys (XAI_API_KEY, OPENROUTER_API_KEY, OPENAI_API_KEY) are read
# from your shell (e.g. .bashrc); never store them here.

# Local harbor fork checkout — UPDATE TO YOUR PATH (cloned by setup.sh).
RUMMY_TBENCH_HARBOR_DIR=~/repo/harbor/main
RUMMY_TBENCH_HARBOR_REPO=https://github.com/possumtech/harbor.git
RUMMY_TBENCH_HARBOR_REF=add-rummy-agent

# Rummy fetched + installed inside harbor's docker sandbox by the
# rummy adapter's install() step. Pin RUMMY_TBENCH_RUMMY_REF to a
# commit SHA for reproducible eval runs.
RUMMY_TBENCH_RUMMY_REPO=https://github.com/possumtech/rummy.git
RUMMY_TBENCH_RUMMY_REF=test/tbench

# Benchmark target.
RUMMY_TBENCH_DATASET=terminal-bench@2.0

# Model aliases (RUMMY_MODEL_<alias>, RUMMY_CONTEXT_<alias>) are
# defined in `.env` only — single source of truth. The per-profile
# overlay files just set RUMMY_TEST_MODEL=<alias>.

# Per-container memory override (MiB), passed to harbor as
# --override-memory-mb. Empty = use the task's declared memory_mb.
# RUMMY_TBENCH_MEMORY_MB=4096

# --- Active selection + per-model knobs live in the overlay files. ---
#   .env.tbench.grok       — xAI direct, grok-4.3 (default sweep target)
#   .env.tbench.gemma      — local llama-server via Cloudflare
#
# Adding a new profile = new overlay file + matching `test:tbench:<name>`
# npm script. See package.json for the wiring pattern.
