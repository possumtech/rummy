{
	"name": "@possumtech/rummy",
	"version": "2.3.3",
	"description": "Relational Unknowns Memory Management Yoke",
	"keywords": [
		"llm"
	],
	"bin": {
		"rummy": "./bin/rummy.js",
		"rummy-cli": "./src/plugins/cli/bin.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/possumtech/rummy#readme",
	"bugs": {
		"url": "https://github.com/possumtech/rummy/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/possumtech/rummy.git"
	},
	"license": "MIT",
	"author": "@wikitopian",
	"engines": {
		"node": ">=25",
		"npm": ">=11"
	},
	"type": "module",
	"main": "service.js",
	"files": [
		"service.js",
		".env.example",
		"bin/",
		"src/",
		"migrations/",
		"lang/",
		"!**/*.test.js"
	],
	"scripts": {
		"postinstall": "node ./bin/postinstall.js",
		"start": "node --env-file-if-exists=.env.example --env-file-if-exists=.env service.js",
		"dev": "node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.dev --watch service.js",
		"debug": "node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.debug --inspect service.js",
		"lint": "biome check src test migrations --fix --unsafe && npm run lint:sql",
		"lint:sql": ". .venv/bin/activate && sqlfluff lint .",
		"fix:sql": ". .venv/bin/activate && sqlfluff fix . --force",
		"test": "npm run lint && npm run test:unit && npm run test:intg",
		"test:all": "npm run lint && npm run test:unit && npm run test:intg && npm run test:e2e",
		"test:unit": "node --env-file-if-exists=.env.example --env-file-if-exists=.env.test --experimental-test-coverage --test-coverage-lines=50 --test-coverage-branches=50 --test-coverage-functions=50 --test-concurrency=1 --test-force-exit --test $(find src -name '*.test.js')",
		"test:intg": "node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test --test-concurrency=1 --test-force-exit --test $(find test/integration -name '*.test.js')",
		"test:e2e": "bash -c 'mkdir -p /tmp/rummy_test_diag; LOG=/tmp/rummy_test_diag/e2e_$(date +%Y%m%dT%H%M%S).log; node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test --test-concurrency=1 --test-force-exit --test-reporter=spec --test $(find test/e2e -name \"*.test.js\") > >(tee \"$LOG\") 2>&1; status=$?; node bin/digest.js /tmp/rummy_test_diag/ 2>&1 | tail -3; exit $status'",
		"test:live": "bash -c 'mkdir -p /tmp/rummy_test_diag; LOG=/tmp/rummy_test_diag/live_$(date +%Y%m%dT%H%M%S).log; node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test --test-concurrency=1 --test-force-exit --test-reporter=spec --test $(find test/live -name \"*.test.js\") > >(tee \"$LOG\") 2>&1'",
		"test:clean": "rm -rf test/lme/results test/swe/results test/swe/repos test/tmp /tmp/rummy_test_diag /tmp/rummy_test_*.db /tmp/rummy_test_*.db-shm /tmp/rummy_test_*.db-wal && echo 'Test artifacts cleaned.'",
		"test:lme:get": "node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test test/lme/download.js",
		"test:lme": "bash -c 'mkdir -p /tmp/rummy_test_diag; LOG=/tmp/rummy_test_diag/lme_$(date +%Y%m%dT%H%M%S).log; node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test test/lme/runner.js \"$@\" > >(tee \"$LOG\") 2>&1' --",
		"test:swe:setup": "bash test/swe/setup.sh",
		"test:swe:get": "node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test test/swe/download.js",
		"test:swe": "bash -c 'mkdir -p /tmp/rummy_test_diag; LOG=/tmp/rummy_test_diag/swe_$(date +%Y%m%dT%H%M%S).log; node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.test test/swe/runner.js \"$@\" > >(tee \"$LOG\") 2>&1' --",
		"test:swe:eval": "bash -c 'cd test/swe && source .venv/bin/activate && python evaluate.py \"$@\"' --",
		"test:swe:baseline": "bash -c 'cd test/swe && source .venv/bin/activate && python baseline.py \"$@\"' --",
		"test:lme:clean": "rm -rf test/lme/results/*/",
		"test:swe:clean": "rm -rf test/swe/results/*/ test/swe/repos/",
		"test:tbench:setup": "bash -c 'set -a; source .env.tbench; set +a; bash test/tbench/setup.sh'",
		"test:tbench": "bash -c 'echo \"Specify a profile: test:tbench:grok | :gemma\" >&2 && exit 64'",
		"test:tbench:gemma": "bash -c 'mkdir -p /tmp/rummy_test_diag; LOG=/tmp/rummy_test_diag/tbench_gemma_$(date +%Y%m%dT%H%M%S).log; node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.tbench --env-file-if-exists=.env.tbench.gemma test/tbench/runner.js \"$@\" > >(tee \"$LOG\") 2>&1' --",
		"test:tbench:grok": "bash -c 'mkdir -p /tmp/rummy_test_diag; LOG=/tmp/rummy_test_diag/tbench_grok_$(date +%Y%m%dT%H%M%S).log; node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.tbench --env-file-if-exists=.env.tbench.grok test/tbench/runner.js \"$@\" > >(tee \"$LOG\") 2>&1' --",
		"test:tbench:clean": "rm -rf test/tbench/results/*/",
		"test:tbench:summary": "node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.tbench test/tbench/summarize.js",
		"test:programbench:setup": "bash test/programbench/setup.sh",
		"test:programbench": "bash -c 'echo \"Specify a profile: test:programbench:grok | :gemma\" >&2 && exit 64'",
		"test:programbench:grok": "bash -c 'mkdir -p /tmp/rummy_test_diag; LOG=/tmp/rummy_test_diag/programbench_grok_$(date +%Y%m%dT%H%M%S).log; node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.programbench.grok test/programbench/runner.js \"$@\" > >(tee \"$LOG\") 2>&1' --",
		"test:programbench:gemma": "bash -c 'mkdir -p /tmp/rummy_test_diag; LOG=/tmp/rummy_test_diag/programbench_gemma_$(date +%Y%m%dT%H%M%S).log; node --env-file-if-exists=.env.example --env-file-if-exists=.env --env-file-if-exists=.env.programbench.gemma test/programbench/runner.js \"$@\" > >(tee \"$LOG\") 2>&1' --",
		"test:programbench:eval": "bash -c 'cd test/programbench && . .venv/bin/activate && programbench eval \"$@\"' --",
		"test:programbench:clean": "rm -rf test/programbench/results/*/",
		"test:clear": "rm -rf /tmp/rummy_test_diag /tmp/rummy_test_*.db /tmp/rummy_test_*.db-shm /tmp/rummy_test_*.db-wal /tmp/rummy-stories-*",
		"test:demo": "node --env-file-if-exists=.env.example --env-file-if-exists=.env bin/demo.js",
		"test:spec": "node test/spec-coverage.js",
		"dev:digest": "bash -c 'DB=\"${1:-rummy_dev.db}\"; NAME=$(basename \"$DB\"); TMP=$(mktemp -d); sqlite3 \"$DB\" \".backup $TMP/$NAME\" && node bin/digest.js \"$TMP/$NAME\"; rm -rf \"$TMP\"' --"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6"
	},
	"dependencies": {
		"@possumtech/sqlrite": "^3.1.0",
		"@xmldom/xmldom": "^0.9.9",
		"diff": "^8.0.4",
		"htmlparser2": "^12.0.0",
		"picomatch": "^4.0.4",
		"ws": "^8.19.0",
		"xpath": "^0.0.34",
		"yauzl-promise": "^4.0.0"
	}
}
